+#ifdef __SWITCH__
+// Asks the display for its highest refresh rate (120 Hz in handheld mode). Setting a swap interval withdraws the request,
+// so it is made again after every change, but not when the interval stays the same.
+extern "C" void switch_s2_set_frame_rates(void);
+static inline int switch_s2_swap_interval(int interval)
+{
+    static int last = -12345;
+    if (interval == last) {
+        return 0;
+    }
+    last = interval;
+    int r = SDL_GL_SetSwapInterval(interval);
+    switch_s2_set_frame_rates();
+    return r;
+}
+#define SDL_GL_SetSwapInterval switch_s2_swap_interval
+#endif
